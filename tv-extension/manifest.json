{
  "manifest_version": 3,
  "name": "RaspiTV Bedienung",
  "version": "2.17",
  "description": "Macht Streaming-Webseiten im RaspiTV-Player mit der Fernbedienung bedienbar.",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://open.spotify.com/*",
        "https://music.apple.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "boot.js"
      ],
      "css": [
        "boot.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "disney-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "spotify-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "media-limit.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "css": [
        "tv.css",
        "netflix.css",
        "netflix-tv.css"
      ],
      "js": [
        "tv.js",
        "netflix.js",
        "netflix-tv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix-bridge.js",
        "netflix-player.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "css": [
        "tv.css",
        "disney-app.css"
      ],
      "js": [
        "tv.js",
        "disney-app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "disney-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*"
      ],
      "js": [
        "prime-boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.primevideo.com/*"
      ],
      "css": [
        "tv.css",
        "netflix-tv.css",
        "disney-tv.css",
        "prime-tv.css"
      ],
      "js": [
        "tv.js",
        "prime-tv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*"
      ],
      "js": [
        "jellyfin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "tv.js",
        "applemusic-app.js",
        "applemusic-tv.js"
      ],
      "css": [
        "tv.css",
        "applemusic-tv.css",
        "applemusic-app.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "applemusic-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://music.apple.com/*",
        "https://open.spotify.com/*",
        "https://www.twitch.tv/*",
        "https://www.ardmediathek.de/*",
        "https://www.zdf.de/*",
        "https://www.3sat.de/*",
        "https://www.arte.tv/*",
        "https://pluto.tv/*",
        "https://www.joyn.de/*"
      ],
      "js": [
        "phone-text.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-keys.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "tv.js",
        "spotify-app.js"
      ],
      "css": [
        "tv.css",
        "applemusic-app.css",
        "spotify-app.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "tv.js",
        "twitch-app.js"
      ],
      "css": [
        "tv.css",
        "twitch-app.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.de/ap/*",
        "https://accounts.spotify.com/*",
        "https://plus.rtl.de/*",
        "https://auth.rtl.de/*",
        "https://tv.apple.com/*",
        "https://www.paramountplus.com/*",
        "https://www.crunchyroll.com/*",
        "https://sso.crunchyroll.com/*",
        "https://www.dazn.com/*",
        "https://app.plex.tv/*"
      ],
      "css": [
        "tv.css"
      ],
      "js": [
        "tv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://idmsa.apple.com/*",
        "https://music.apple.com/includes/commerce/authenticate*",
        "https://tv.apple.com/includes/commerce/authenticate*",
        "https://app.plex.tv/auth-form*"
      ],
      "css": [
        "tv.css"
      ],
      "js": [
        "tv.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.ardmediathek.de/*",
        "https://www.3sat.de/*"
      ],
      "js": [
        "media-boot.js",
        "tv.js",
        "vendor/hls.min.js",
        "media-app.js",
        "ard-app.js"
      ],
      "css": [
        "tv.css",
        "media-app.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.zdf.de/*"
      ],
      "js": [
        "media-boot.js",
        "tv.js",
        "vendor/hls.min.js",
        "media-app.js",
        "zdf-app.js"
      ],
      "css": [
        "tv.css",
        "media-app.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.arte.tv/*"
      ],
      "js": [
        "media-boot.js",
        "tv.js",
        "vendor/hls.min.js",
        "media-app.js",
        "arte-app.js"
      ],
      "css": [
        "tv.css",
        "media-app.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pluto.tv/*"
      ],
      "js": [
        "media-boot.js",
        "tv.js",
        "vendor/hls.min.js",
        "media-app.js",
        "pluto-app.js"
      ],
      "css": [
        "tv.css",
        "media-app.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.joyn.de/*"
      ],
      "js": [
        "joyn-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.joyn.de/*"
      ],
      "js": [
        "media-boot.js",
        "tv.js",
        "media-app.js",
        "joyn-app.js"
      ],
      "css": [
        "tv.css",
        "media-app.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "media",
        "enabled": true,
        "path": "media-rules.json"
      },
      {
        "id": "disney",
        "enabled": true,
        "path": "disney-rules.json"
      }
    ]
  }
}
